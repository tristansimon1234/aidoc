# En local, seule GEMINI_API_KEY est nécessaire : sans SUPABASE_URL, l'app passe en mode local
# (pas de connexion, données dans .local-data/).

# ── Obligatoire en production ────────────────────────────────
# Port du serveur en local (ignoré sur Vercel)
PORT=3000
# URL publique de l'app (retours Stripe après paiement)
APP_URL=http://localhost:5173

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Service vidéo (Railway). Vide en local : les vidéos sont traitées dans le même process.
VIDEO_SERVICE_URL=
# Secret partagé Vercel ↔ Railway (même valeur des deux côtés)
VIDEO_SERVICE_SECRET=generate-a-long-random-string

# Traitement vidéo (Railway, ou local)
GEMINI_API_KEY=your-gemini-key

# Frontend (lu par Vite au build)
# Adresse de l'API si elle n'est pas sur le même site (test sans Supabase : l'URL Railway)
VITE_API_URL=
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Optionnel ────────────────────────────────────────────────
# Force le mode local (disque, sans connexion) même si SUPABASE_URL est défini — tests sur Railway
LOCAL_MODE=
# Modèles Gemini (à mettre à jour quand Google en retire un)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Vidéos marketing animées : le modèle qui code les scènes. Claude si la clé est définie (recommandé),
# sinon Gemini (GEMINI_CODE_MODEL). Remotion sert au rendu : licence gratuite jusqu'à 3 personnes,
# au-delà une licence entreprise (remotion.pro).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
GEMINI_CODE_MODEL=gemini-2.5-pro
# Navigateur pour le rendu Remotion en local (sinon celui téléchargé par scripts/bundle-remotion.mjs)
REMOTION_BROWSER_EXECUTABLE=

# Voix premium (ElevenLabs) : toutes les voix du compte sont proposées, voix clonées comprises.
# Sans clé, seules les voix Gemini sont proposées. ELEVENLABS_VOICE_ID = voix des anciennes SOP « premium ».
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Modèle ElevenLabs : Flash par défaut (le moins cher) ; eleven_multilingual_v2 ou eleven_v3 = plus expressif
ELEVENLABS_MODEL=eleven_flash_v2_5
# Modèle ElevenLabs des vidéos marketing (le plus expressif)
ELEVENLABS_MARKETING_MODEL=eleven_v3

# Paiement Stripe. Sans clé, l'achat de crédits est désactivé.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PACK=     # paiement unique → 10 crédits
STRIPE_PRICE_MONTHLY=  # abonnement mensuel → 30 crédits / mois

# Mode test : pas d'écran de connexion, compte partagé test@doclee.dev.
# Uniquement sur un déploiement protégé. Les deux doivent valoir true.
DISABLE_LOGIN=
VITE_DISABLE_LOGIN=
