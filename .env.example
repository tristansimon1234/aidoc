# ── Obligatoire ──────────────────────────────────────────────
PORT=3000
# URL publique de l'app (retours Stripe après paiement)
APP_URL=http://localhost:5173

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
GEMINI_API_KEY=your-gemini-key

# Frontend (lu par Vite au build)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Optionnel ────────────────────────────────────────────────
# Modèles Gemini (à mettre à jour quand Google en retire un)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Voix « Premium » (ElevenLabs). Sans clé, seule la voix Standard (Gemini) est proposée.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Paiement Stripe. Sans clé, l'achat de crédits est désactivé.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PACK=     # paiement unique → 10 crédits
STRIPE_PRICE_MONTHLY=  # abonnement mensuel → 30 crédits / mois
