# Backend (Vercel env vars)
NODE_ENV=development
PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
ANTHROPIC_API_KEY=sk-ant-your-key
BROWSERBASE_API_KEY=your-browserbase-api-key
BROWSERBASE_PROJECT_ID=your-browserbase-project-id

# Video microservice (ffmpeg + async long-video analysis). Optional — when
# unset, video analysis runs inline (short recordings only).
VIDEO_SERVICE_URL=https://your-video-service.up.railway.app
# Async long-video pipeline (compress + chunk + Gemini off Vercel). Both are
# required for the long-video path; when either is missing, analyze-video falls
# back to the inline (300s-bound) path.
#   PUBLIC_API_URL — this backend's own public API base, INCLUDING the /api
#   prefix used in production. The video-service calls back to
#   ${PUBLIC_API_URL}/internal/video-analysis-callback when a job finishes.
PUBLIC_API_URL=https://app.doclee.tech/api
#   INTERNAL_CALLBACK_SECRET — shared secret echoed by the worker in the
#   x-callback-secret header; the callback route rejects anything else.
INTERNAL_CALLBACK_SECRET=generate-a-long-random-string

# Frontend (prefix with VITE_ for Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
