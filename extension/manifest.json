{
  "manifest_version": 3,
  "name": "doclee Recorder",
  "version": "1.0.0",
  "description": "Capture DOM events during screen recordings for richer AI-generated documentation.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
