{
  "buildCommand": "node scripts/bundle-remotion.mjs && node scripts/copy-remotion-bundle.mjs && vite build",
  "outputDirectory": "dist/client",
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300
    },
    "api/docs-ssr.ts": {
      "maxDuration": 10,
      "includeFiles": "dist/client/index.html"
    }
  },
  "crons": [
    {
      "path": "/api/cron/classify-messages",
      "schedule": "0 * * * *"
    }
  ],
  "rewrites": [
    { "source": "/docs/:projectId/:slug?", "destination": "/api/docs-ssr" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/remotion-bundle/(.*)", "destination": "/remotion-bundle/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/widget.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
