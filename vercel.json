{
  "buildCommand": "node scripts/bundle-remotion.mjs && node scripts/copy-remotion-bundle.mjs && vite build",
  "outputDirectory": "dist/client",
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300
    },
    "api/docs-ssr.ts": {
      "maxDuration": 10,
      "includeFiles": "dist/client/index.html"
    }
  },
  "rewrites": [
    { "source": "/docs/:projectId/:slug?", "destination": "/api/docs-ssr" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
