{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist/web",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "excludeFiles": "{node_modules/@remotion/**,node_modules/remotion/**,node_modules/@esbuild/**,node_modules/esbuild/**,remotion/**}"
    }
  }
}
