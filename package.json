{
  "name": "doclee",
  "version": "2.0.0",
  "description": "Doclee — une vidéo d'écran devient une SOP (texte + captures) et une vidéo narrée",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch --env-file=.env server/index.ts\" \"vite\"",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p remotion/tsconfig.json",
    "bundle:remotion": "node scripts/bundle-remotion.mjs",
    "test": "vitest run",
    "format": "prettier --write 'server/**/*.ts' 'web/**/*.{ts,tsx}' 'remotion/**/*.{ts,tsx}'",
    "start:video-service": "node dist/worker/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@google/genai": "^2.24.0",
    "@remotion/bundler": "^4.0.528",
    "@remotion/renderer": "^4.0.528",
    "@supabase/supabase-js": "^2.117.1",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "remotion": "^4.0.528",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
