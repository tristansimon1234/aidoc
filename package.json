{
  "name": "doclee",
  "version": "2.0.0",
  "description": "Doclee — une vidéo d'écran devient une SOP (texte + captures) et une vidéo narrée",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch --env-file=.env server/index.ts\" \"vite\"",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write 'server/**/*.ts' 'web/**/*.{ts,tsx}'",
    "start:video-service": "node dist/worker/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@supabase/supabase-js": "^2.117.1",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
